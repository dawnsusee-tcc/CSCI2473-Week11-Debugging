{
  "name": "TCC c debugging",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-debian-12",
  "hostRequirements": {
    "cpus": 2
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/check.sh",
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ]
}
